    "comparison_variables": "1h/4h/1d higher-timeframe lookback-return variants. 1h는 data coverage 제한으로 실행되지 않았습니다.",
    "initial_capital": "1,000,000 KRW converted at 1,500 KRW/USDT, effective 666.67 USDT",
    "position_sizing": "cash_fraction 0.10",
    "entry_conditions_summary": "최근 lookback_bars개 완료봉 종가 수익률이 entry_threshold 이상이면 Long, -entry_threshold 이하이면 Short.",
    "exit_conditions_summary": "진입 시점 ATR(14, RMA)을 기준으로 1 ATR 손절, 1 ATR 익절, holding_bars 시간 청산. 같은 candle에서 손절과 익절이 모두 닿으면 손절 우선.",
    "cost_assumptions": "수수료, 스프레드, 슬리피지를 모두 0으로 둔 gross/no-cost 조건.",
    "execution_assumption": "신호 candle close에서 진입하고 다음 완료봉부터 청산 조건을 확인합니다.",
    "algorithm_explanation": {
      "plain_language_summary": "완료봉 종가로 과거 수익률을 계산하고, 기준을 넘는 방향으로만 진입합니다. 청산 거리는 진입 시점 ATR로 고정합니다.",
      "entry_logic_pseudocode": "lookback_return = close[t] / close[t - lookback_bars] - 1\nif lookback_return >= entry_threshold: signal = \"long\"\nelif lookback_return <= -entry_threshold: signal = \"short\"\nelse: signal = \"flat\"",
      "exit_logic_pseudocode": "risk_distance = ATR_14_RMA[t]\nlong_stop = entry_price - risk_distance\nlong_target = entry_price + risk_distance\nshort_stop = entry_price + risk_distance\nshort_target = entry_price - risk_distance\ncheck exits from t + 1; stop first, target second, time exit third",
      "indicator_calculations": [
        {
          "name": "ATR(14, RMA)",
          "pseudocode": "true_range = max(high-low, abs(high-prev_close), abs(low-prev_close))\natr = RMA(true_range, 14)",
          "inputs": "completed high/low/close",
          "window": "14",
          "warmup_policy": "ATR이 유효하지 않으면 진입하지 않습니다."
        }
      ],
      "no_lookahead_note": "신호와 ATR은 신호 candle까지의 완료봉만 사용합니다.",
      "fill_timing_note": "진입은 신호 candle close, 청산 확인은 다음 완료봉부터 시작합니다.",
      "source_reference": null
    }
  },
